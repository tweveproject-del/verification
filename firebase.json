{
  "hosting": {
    "site": "twevetester",
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "/twevetunnel.dat",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"TweveTunnel.apk\""
          },
          {
            "key": "Content-Type",
            "value": "application/vnd.android.package-archive"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      },
      {
        "source": "/TweveTunnel.zip",
        "headers": [
          {
            "key": "Content-Disposition",
            "value": "attachment; filename=\"TweveTunnel.zip\""
          },
          {
            "key": "Content-Type",
            "value": "application/zip"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          },
          {
            "key": "Access-Control-Allow-Origin",
            "value": "*"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
